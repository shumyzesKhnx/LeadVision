# Copy to backend/.env if you want to change these defaults. Do not commit .env.
# Relative paths are resolved from the project folder, not your terminal folder.
LEADVISION_DATA_DIR=data
LEADVISION_DATABASE_NAME=leadvision.sqlite3
# Set true when using an existing database (for example after restore).
# With true, startup fails if the database is missing instead of creating a new one.
LEADVISION_DATABASE_MUST_EXIST=false
LEADVISION_SQLITE_BUSY_TIMEOUT_MS=5000
LEADVISION_API_HOST=127.0.0.1
LEADVISION_API_PORT=8000
LEADVISION_LOG_LEVEL=INFO
LEADVISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Handlers use bounded I/O and cooperative cancellation checkpoints.
LEADVISION_JOB_DEADLINE_SECONDS=300
LEADVISION_STAGE_DEADLINE_SECONDS=120
LEADVISION_WORKER_POLL_SECONDS=0.5
# Unattached saved uploads expire after one hour; the worker cleans them up.
LEADVISION_SAVED_UPLOAD_TTL_SECONDS=3600
# Use an already-installed local model. No automatic model downloads.
LEADVISION_GENERATION_MODEL=qwen2.5:3b
LEADVISION_NLP_CONTEXT_TOKENS=4096
LEADVISION_NLP_OUTPUT_TOKENS=768
LEADVISION_NLP_EVIDENCE_BYTES=1600
LEADVISION_NLP_TIMEOUT_SECONDS=110
LEADVISION_OUTREACH_CONTEXT_TOKENS=8192
LEADVISION_OUTREACH_OUTPUT_TOKENS=1536

# Local CPU MiniLM files, installed once with scripts/setup_embeddings.py.
# Relative paths are anchored at the project root.
LEADVISION_EMBEDDING_MODEL_DIR=models/all-minilm-l6-v2

# Existing browser used only for isolated headless live captures: chrome or msedge.
# The browser always uses the validating proxy; there is no direct-network fallback.
LEADVISION_BROWSER_CHANNEL=chrome

# Copy to backend/.env if you want to change these defaults. Do not commit .env.
# Relative paths are resolved from the project folder, not your terminal folder.
LEADVISION_DATA_DIR=data
LEADVISION_DATABASE_NAME=leadvision.sqlite3
# Set true when using an existing database (for example after restore).
# With true, startup fails if the database is missing instead of creating a new one.
LEADVISION_DATABASE_MUST_EXIST=false
LEADVISION_SQLITE_BUSY_TIMEOUT_MS=5000
LEADVISION_API_HOST=127.0.0.1
LEADVISION_API_PORT=8000
LEADVISION_LOG_LEVEL=INFO
LEADVISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
